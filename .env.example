# .env.example — Copy thành .env rồi điền giá trị thật
# KHÔNG commit file .env lên Git!
# ── WordPress ───────────────────────────────────────────────
WP_TIMEOUT=15

WP_SITES='[
  {"url":"","username":"","app_password":""},
  {"url":"","username":"","app_password":""}
]'
# ── OpenClaw ────────────────────────────────────────────────
OPENCLAW_BIN=/root/.openclaw/tmp/node-compile-cache/openclaw
OPENCLAW_TIMEOUT=30

# ── Ollama ────────────────────────────────────────────────
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:20b

# ── Buffer ──────────────────────────────────────────────────
BUFFER_API_KEY=
BUFFER_ORG_ID=
BUFFER_YOUTUBE_CHANNELS=
BUFFER_THREADS_CHANNELS=
BUFFER_TIKTOK_CHANNELS=

# ── Facebook Pages ──────────────────────────────────────────────────
FACEBOOK_PAGES='[
  {"id":"","name":"","access_token":""},
  {"id":"","name":"","access_token":""}
]'

# ── Google Drive ─────────────────────────────────────────────
GDRIVE_API_URL=http://host.docker.internal:8080
GDRIVE_API_TIMEOUT=30
GDRIVE_LANGUAGE=vi

# ── Zalo OA ──────────────────────────────────────────────────
ZALO_API_URL=http://host.docker.internal:8001/index.php?entryPoint=epZaloPost
ZALO_API_KEY=
ZALO_APP_ID=
ZALO_TIMEOUT=30

# ── App ─────────────────────────────────────────────────────
OUTPUT_DIR=/app/output

# ── Telegram Chat ID ─────────────────────────────────────────────────────
CHAT_IDS=